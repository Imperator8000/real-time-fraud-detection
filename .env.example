# ============================================================
# REAL-TIME FRAUD DETECTION
# LOCAL DEVELOPMENT CONFIGURATION
# ============================================================

# Spark
SPARK_MASTER=local[*]
SPARK_SQL_SHUFFLE_PARTITIONS=8
SPARK_DEFAULT_PARALLELISM=8
SPARK_LOG_LEVEL=WARN

# ============================================================
# SPARK + KAFKA CONNECTOR
# ============================================================

SPARK_VERSION=3.5.9
SPARK_SCALA_BINARY_VERSION=2.12

# Kafka source used from inside Docker
KAFKA_INTERNAL_BOOTSTRAP_SERVERS=broker:19092
KAFKA_TRANSACTION_TOPIC=transactions

# For the first Bronze query we deliberately consume existing
# records so the transactions already produced are processed.
KAFKA_STARTING_OFFSETS=earliest

# Safety limit for local development.
SPARK_KAFKA_MAX_OFFSETS_PER_TRIGGER=5000

# Bronze micro-batch interval
BRONZE_TRIGGER_INTERVAL=5 seconds

# ============================================================
# SILVER STREAMING
# ============================================================

SILVER_TRIGGER_INTERVAL=5 seconds

EVENT_TIME_WATERMARK=5 minutes

# ============================================================
# FRAUD WINDOW FEATURES
# ============================================================

FRAUD_WINDOW_DURATION=10 minutes
FRAUD_WINDOW_SLIDE=2 minutes

# How long Spark tolerates late event-time records.
EVENT_TIME_WATERMARK=5 minutes

# Initial heuristic feature thresholds.
# These are NOT the final fraud decision.
HIGH_VELOCITY_TRANSACTION_THRESHOLD=5
MULTI_DEVICE_THRESHOLD=2

WINDOW_FEATURE_TRIGGER_INTERVAL=5 seconds

# ============================================================
# STATEFUL USER BEHAVIOR
# ============================================================

# Event-time lateness allowed before Spark advances the watermark.
USER_STATE_WATERMARK=5 minutes

# Remove state for users whose event time has been inactive
# for this many minutes.
USER_STATE_TIMEOUT_MINUTES=30

# Exact rule requested by the project specification.
HISTORICAL_AMOUNT_MULTIPLIER=3.0

# For our stronger production-quality signal, require this many
# prior transactions before considering the baseline mature.
MIN_HISTORICAL_TRANSACTIONS=3

STATEFUL_TRIGGER_INTERVAL=5 seconds

# ============================================================
# HYBRID FRAUD ENGINE
# ============================================================

FRAUD_ZSCORE_THRESHOLD=3.0

FRAUD_AMOUNT_RATIO_THRESHOLD=3.0

FRAUD_HIGH_VELOCITY_MIN_COUNT=5

FRAUD_DEVICE_AMOUNT_RATIO_THRESHOLD=2.0

FRAUD_MERCHANT_DIVERSITY_THRESHOLD=0.80

FRAUD_RULE_SCORE_THRESHOLD=4

FRAUD_FEATURE_TRIGGER_INTERVAL=5 seconds

# ============================================================
# LIVE MODEL SERVING
# ============================================================

LIVE_FEATURE_TRIGGER_INTERVAL=5 seconds

# Used with Delta txnVersion for idempotent foreachBatch writes.
LIVE_FEATURE_TXN_APP_ID=fraud-live-feature-events-v1

# Final decision thresholds
ML_FRAUD_PROBABILITY_THRESHOLD=0.80
ML_HYBRID_CONFIRMATION_THRESHOLD=0.40
ML_MEDIUM_RISK_THRESHOLD=0.35
ML_CRITICAL_PROBABILITY_THRESHOLD=0.95

RULE_ONLY_CRITICAL_SCORE_THRESHOLD=8

FINAL_SCORING_TRIGGER_INTERVAL=5 seconds

FINAL_SCORED_TXN_APP_ID=fraud-final-scored-v1
FRAUD_ALERT_TXN_APP_ID=fraud-final-alerts-v1

# ============================================================
# STREAMING OBSERVABILITY
# ============================================================

SPARK_STREAMING_METRICS_ENABLED=true

SPARK_STREAMING_RECENT_PROGRESS=200

STREAMING_METRICS_DIR=data/monitoring/streaming_progress

# Spark event logs will later allow us to inspect lower-level
# stage/task/shuffle behavior through Spark History Server.
SPARK_EVENT_LOG_ENABLED=true
SPARK_EVENT_LOG_DIR=file:///workspace/logs/spark-events

# ============================================================
# STATEFUL SKEW / BACKPRESSURE
# ============================================================

STATEFUL_MAX_FILES_PER_TRIGGER=20

HOT_USER_SHARE_THRESHOLD=0.20