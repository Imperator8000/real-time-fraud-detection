# ============================================================
# TEXT FILES
# ============================================================

* text=auto

*.py      text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.toml    text eol=lf
*.ini     text eol=lf
*.env     text eol=lf
*.example text eol=lf
*.txt     text eol=lf
*.csv     text eol=lf


# ============================================================
# WINDOWS SCRIPTS
# ============================================================

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf


# ============================================================
# BINARY FILES
# ============================================================

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.parquet binary